# --- MikroTik: monitoring account (read-only, group "monitor") ---
MIKROTIK_USER=monitor
MIKROTIK_PASS=

# --- mktk-map web UI login (independent of the MikroTiks) ---
APP_USER=admin
# generate: docker compose run --rm --no-deps mktk-map python auth.py
APP_PASS_HASH=

# --- HTTPS proxy ---
# random string, e.g. Linux/macOS: openssl rand -hex 20   or PowerShell:
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
PROXY_SECRET=
# address where https://<MKTK_HOST>:8443 will run (IP of this server)
MKTK_HOST=192.168.88.10

# --- optional ---
# address on which port 8080 (API tokens for Home Assistant) is published; default all.
# 127.0.0.1 = only from this server, or one LAN IP of the server
#API_BIND=0.0.0.0
